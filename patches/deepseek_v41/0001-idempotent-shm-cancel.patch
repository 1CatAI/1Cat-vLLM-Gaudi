+def test_spin_condition_concurrent_cancel_wakes_reader_once():
+    """Parent death and worker cleanup must not share a concurrent socket send."""
+    from concurrent.futures import ThreadPoolExecutor
+
+    import zmq
+
+    from vllm.utils.network_utils import get_open_zmq_inproc_path
+
+    with zmq.Context() as context:
+        reader = shm_broadcast.SpinCondition(
+            True, context, get_open_zmq_inproc_path(), busy_loop_s=0
+        )
+        socket = reader.write_cancel_socket
+        wire_lock = threading.Lock()
+        barrier = threading.Barrier(16)
+
+        def send(value):
+            # Keep the regression test safe on the broken implementation:
+            # duplicate sends must fail an assertion, not abort libzmq.
+            with wire_lock:
+                time.sleep(0.001)
+                socket.send(value)
+
+        spy = mock.Mock(side_effect=send)
+        reader.write_cancel_socket = SimpleNamespace(send=spy)
+
+        def cancel(_):
+            barrier.wait(timeout=5)
+            reader.cancel()
+
+        with ThreadPoolExecutor(max_workers=16) as pool:
+            list(pool.map(cancel, range(16)))
+        reader.cancel()
+        spy.assert_called_once_with(b"\x00")
+        assert reader.read_cancel_socket.poll(timeout=1000) & zmq.POLLIN
+        reader.wait(timeout_ms=1000)
+
+
