+TEST_F_SYN(SynApiNoDeviceTest, tensor_reuse_and_minimal_latency_contract)
+{
+    synGraphHandle graph {};
+    ASSERT_EQ(synSuccess, synGraphCreate(&graph, m_deviceType));
