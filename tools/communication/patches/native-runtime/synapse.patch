+// Narrow compatibility experiment for the audited 2048-token prefill GEMM.
+// The production descriptor dump uses four aligned CD partials and a 2x2
+// output tile. This does not claim general compatibility with newer MME ABIs.
+static bool useReferenceFp8Partition(const RecipeConstants& constants, const MmeRecipe& recipe)
+{
+    const char* enabled = std::getenv("SYN_NATIVE_MME_REFERENCE_SPLIT");
+    const auto& p = constants.params;
+    const bool selected = enabled && std::strcmp(enabled, "1") == 0 && recipe.reuseA() &&
+           p.strategy.sbReuse && p.strategy.pattern == e_mme_sp_reduction_fck &&
+           constants.mmeHalReader.getChipType() == ChipType::e_mme_Gaudi2 &&
+           p.opType == e_mme_abt && p.x.elementType == e_type_fp8_143 &&
+           p.w.elementType == e_type_fp8_143 && p.x.sizes[0] == 8704 && p.x.sizes[1] == 2048 &&
+           p.w.sizes[0] == 8704 && (p.w.sizes[1] == 1280 || p.w.sizes[1] == 1024) &&
+           p.x.sizes[2] == 1 && p.x.sizes[3] == 1 && p.x.sizes[4] == 1 &&
+           p.w.sizes[2] == 1 && p.w.sizes[3] == 1 && p.w.sizes[4] == 1 &&
+           constants.geoAttr.getGeometryWidth() == 256 && constants.geoAttr.getGeometryHeight() == 512;
+    return selected;
+}
