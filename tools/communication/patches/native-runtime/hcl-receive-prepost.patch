+extern "C" hcclResult_t HCCL_API_CALL hcclTpNativeGraphEnableReceivePrepostV1(hcclTp2NativeGraphHandle graph){
+ if(!graph)return hcclInvalidArgument;
+ std::lock_guard<std::mutex> lock(graph->mutex);
+ if(graph->state!=hcclTp2NativeGraphCreated || graph->tp4Phase!=2 ||
+    graph->params.m_dataType!=hcclBfloat16)return hcclInvalidUsage;
+ graph->prepostedReceives=true;return hcclSuccess;
+}
+extern "C" hcclResult_t HCCL_API_CALL hcclTpNativeBatchReplayReceiveEpochV1(hcclTp2NativeBatchHandle batch,
+ const hcclTp2NativeSyncInfo* epoch,const hcclTp2NativeSyncInfo* dependencies,size_t count,
+ hcclTp2NativeSyncInfo* completions){
+ if(!batch || !epoch || !dependencies || !completions || count!=batch->graphs.size() ||
+    !epoch->targetValue || epoch->targetValue>=(uint64_t(1)<<60))return hcclInvalidArgument;
+ std::lock_guard<std::mutex> lock(batch->mutex);
+ if(!batch->valid || batch->split || batch->segmentedActive)return hcclInvalidUsage;
+ for(size_t node=0;node<count;++node){
+  if(!batch->graphs[node]->prepostedReceives || dependencies[node].longSoIndex!=epoch->longSoIndex ||
+     dependencies[node].targetValue<epoch->targetValue)return hcclInvalidUsage;
+  batch->states[node].values[static_cast<size_t>(hcl::NativeHclRelocationKind::RECEIVE_EPOCH_TARGET)]=epoch->targetValue;
+  batch->states[node].values[static_cast<size_t>(hcl::NativeHclRelocationKind::RECEIVE_EPOCH_LONG_SO_INDEX)]=epoch->longSoIndex;
+ }
+ return replayNativeBatchRangeLocked(*batch,0,batch->phases,dependencies,count,completions);
+}
+extern "C" HCCL_API_CALL uint32_t hcclTpNativeReceiveEpochVersion(){return 1;}
