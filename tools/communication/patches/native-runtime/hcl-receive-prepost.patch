+extern "C" hcclResult_t HCCL_API_CALL hcclTpNativeBatchReplayReceiveEpochV2(
+    hcclTp2NativeBatchHandle batch, const hcclTp2NativeSyncInfo* epoch,
+    const hcclTp2NativeSyncInfo* dependencies, size_t count, hcclTp2NativeSyncInfo* completions)
+{
+    if (!batch || !epoch || !dependencies || !completions || !epoch->targetValue ||
+        epoch->targetValue >= (uint64_t(1) << 60) || epoch->longSoIndex % 8 ||
+        (epoch->longSoIndex >> 3) > 0xff) return hcclInvalidArgument;
+    std::lock_guard<std::mutex> lock(batch->mutex);
+    if (!batch->valid) return hcclInvalidUsage;
+    try {
+        const auto window = hcl::NativeReceiveEpochWindow::prepare(
+            batch->graphs.size(), batch->split, batch->segmentedActive, count);
+        for (size_t node = 0; node < count; ++node) {
+            if (!batch->graphs[window.offset + node]->prepostedReceives ||
+                dependencies[node].longSoIndex != epoch->longSoIndex ||
+                dependencies[node].targetValue < epoch->targetValue ||
+                dependencies[node].targetValue >= (uint64_t(1) << 60)) return hcclInvalidUsage;
+        }
+        for (size_t node = 0; node < count; ++node) {
+            auto& values = batch->states[window.offset + node].values;
+            values[static_cast<size_t>(hcl::NativeHclRelocationKind::RECEIVE_EPOCH_TARGET)] = epoch->targetValue;
+            values[static_cast<size_t>(hcl::NativeHclRelocationKind::RECEIVE_EPOCH_LONG_SO_INDEX)] = epoch->longSoIndex;
+        }
+        const auto& phases = window.part == hcl::NativeReceiveEpochWindow::Part::Full ? batch->phases
+            : window.part == hcl::NativeReceiveEpochWindow::Part::Prefix ? batch->prefixPhases : batch->suffixPhases;
+        const auto result = replayNativeBatchRangeLocked(*batch, window.offset, phases, dependencies, count, completions);
+        if (result == hcclSuccess) batch->segmentedActive = window.nextActive;
+        return result;
+    } catch (const std::invalid_argument&) { return hcclInvalidArgument; }
+}
