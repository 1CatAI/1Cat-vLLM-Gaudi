+extern "C" synStatus SYN_API_CALL synNativeComputeGraphPrepareEpochPlanV1(synNativeComputeGraphHandle handle,
+ const uint32_t* producers,const uint32_t* consumers,uint64_t count,uint32_t index,
+ NativeComputeGraph::EpochExchangeReplay callback,void* context){
+ if(!callback || !producers || !handle || !handle->queue || !handle->graph || !handle->stream)return synInvalidArgument;
+ std::lock_guard<std::mutex> lock(handle->replayMutex);
+ if(handle->preparedReplayJob)return synInvalidArgument;
+ auto unused=[](void*,const synNativeGraphSyncInfo*,uint64_t,synNativeGraphSyncInfo*) -> int {return -1;};
+ auto status=handle->queue->prepareNativeComputePlan(*handle->graph,consumers,count,index,unused,context,producers);
+ if(status!=synSuccess)return status;
+ status=handle->graph->configureEpochCallback(callback);
+ if(status!=synSuccess)return status;
+ handle->preparedReplayJob=std::make_unique<NativeComputeReplayJob>(*handle,NativeComputeReplayJob::Part::Full);
+ return synSuccess;
+}
+extern "C" uint32_t SYN_API_CALL synNativeComputeGraphEpochPlanVersion(){return 2;}
+
+extern "C" synStatus SYN_API_CALL synNativeComputeGraphPrepareSegmentedEpochPlanV2(
+    synNativeComputeGraphHandle handle, const uint32_t* producers, const uint32_t* consumers,
+    uint64_t count, uint64_t prefixCollectives, uint32_t prefixComputes, uint32_t nicIndex,
+    NativeComputeGraph::EpochExchangeReplay callback, void* context)
+{
+    if (!callback || !producers || !handle || !handle->queue || !handle->graph || !handle->stream)
+        return synInvalidArgument;
+    std::lock_guard<std::mutex> lock(handle->replayMutex);
+    if (handle->preparedReplayJob || handle->preparedPrefixReplayJob || handle->preparedFinishReplayJob)
+        return synInvalidArgument;
+    auto unused = [](void*, const synNativeGraphSyncInfo*, uint64_t, synNativeGraphSyncInfo*) -> int { return -1; };
+    auto status = handle->queue->prepareSegmentedNativeComputePlan(
+        *handle->graph, producers, consumers, count, prefixCollectives, prefixComputes, nicIndex, unused, context);
+    if (status != synSuccess) return status;
+    status = handle->graph->configureEpochCallback(callback);
+    if (status != synSuccess) return status;
+    handle->preparedReplayJob = std::make_unique<NativeComputeReplayJob>(*handle, NativeComputeReplayJob::Part::Full);
+    handle->preparedPrefixReplayJob = std::make_unique<NativeComputeReplayJob>(*handle, NativeComputeReplayJob::Part::Prefix);
+    handle->preparedFinishReplayJob = std::make_unique<NativeComputeReplayJob>(*handle, NativeComputeReplayJob::Part::Finish);
+    return synSuccess;
+}
