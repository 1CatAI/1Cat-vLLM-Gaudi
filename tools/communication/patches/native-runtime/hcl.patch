+                                                       sendbuff,
+                                                       recvbuff,
+                                                       count,
+                                                       datatype,
+                                                       reduceOp,
+                                                       streamHandle,
+                                                       mode,
+                                                       hccl_ctx.generateApiId());
+        handle->graph = ar_createTp2DirectGraph(
