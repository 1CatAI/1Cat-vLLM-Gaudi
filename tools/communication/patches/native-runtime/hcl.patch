diff --git a/hcl/src/infra/scal/gen2_arch_common/native_hcl_program.h b/hcl/src/infra/scal/gen2_arch_common/native_hcl_program.h
new file mode 100644
index 0000000..0e27bd2
--- /dev/null
+++ b/hcl/src/infra/scal/gen2_arch_common/native_hcl_program.h
@@ -0,0 +1,102 @@
+#pragma once
+
+#include "native_hcl_relocation.h"
+#include <stdexcept>
+#include <utility>
+
+namespace hcl
+{
+struct NativeHclProgramPatch
+{
+    uint32_t stateIndex = 0;
+    NativeHclRelocation field;
+};
+
+struct NativeHclProgramPage
+{
+    std::vector<uint8_t> bytes;
+    std::vector<NativeHclProgramPatch> patches;
+    uint32_t lastStateIndex = 0;
+    bool publishAfter = false;
+};
+
+// An immutable stream program can combine any number of collective templates.
+// Packet boundaries and relocation validity are resolved once at instantiation.
+class NativeHclProgram
+{
+public:
+    using Input = std::pair<const NativeHclStreamTemplate*, uint32_t>;
+
+    static NativeHclProgram prepare(const std::vector<Input>& inputs, size_t alignment,
+                                    bool preserveCapturedPublications = true)
+    {
+        if (inputs.empty() || alignment == 0 || (alignment & (alignment - 1)) != 0)
+            throw std::invalid_argument("Invalid native HCL program alignment or inputs");
+        NativeHclProgram result;
+        result.m_alignment = alignment;
+        for (const auto& input : inputs)
+        {
+            if (input.first == nullptr || !validateNativeHclStreamTemplate(*input.first))
+                throw std::invalid_argument("Invalid native HCL program template");
+            const auto& commandTemplate = *input.first;
+            size_t patch = 0;
+            for (size_t commandIndex = 0; commandIndex < commandTemplate.commands.size(); ++commandIndex)
+            {
+                const auto& command = commandTemplate.commands[commandIndex];
+                if (command.bytes.empty() || command.bytes.size() > alignment)
+                    throw std::invalid_argument("Native HCL packet exceeds its scheduler alignment");
+                if (result.m_pages.empty() || result.m_pages.back().publishAfter ||
+                    result.m_pages.back().bytes.size() + command.bytes.size() > alignment)
+                    result.m_pages.emplace_back();
+                auto& page = result.m_pages.back();
+                const size_t offset = page.bytes.size();
+                page.bytes.insert(page.bytes.end(), command.bytes.begin(), command.bytes.end());
+                page.lastStateIndex = input.second;
+                page.publishAfter = preserveCapturedPublications && command.submitAfter;
+                while (patch < commandTemplate.relocations.size() &&
+                       commandTemplate.relocations[patch].commandIndex == commandIndex)
+                {
+                    auto field = commandTemplate.relocations[patch++];
+                    if (offset > std::numeric_limits<uint32_t>::max() - field.byteOffset)
+                        throw std::overflow_error("Native HCL program relocation offset overflow");
+                    field.byteOffset += static_cast<uint32_t>(offset);
+                    field.commandIndex = 0;
+                    page.patches.push_back({input.second, field});
+                }
+                result.m_bytes += command.bytes.size();
+            }
+            result.m_stateCount = std::max(result.m_stateCount, size_t(input.second) + 1);
+        }
+        return result;
+    }
+
+    const std::vector<NativeHclProgramPage>& pages() const { return m_pages; }
+    size_t stateCount() const { return m_stateCount; }
+    size_t alignment() const { return m_alignment; }
+    size_t bytes() const { return m_bytes; }
+
+    // Caller checks stateCount once for the program. Each field was validated
+    // during prepare, so this hot loop performs only the required epoch update.
+    static void writePage(uint8_t* destination,
+                          const NativeHclProgramPage& page,
+                          const NativeHclReplayState* states)
+    {
+        std::memcpy(destination, page.bytes.data(), page.bytes.size());
+        for (const auto& patch : page.patches)
+        {
+            const auto& field = patch.field;
+            uint64_t word = 0;
+            std::memcpy(&word, destination + field.byteOffset, field.width);
+            const uint64_t value = states[patch.stateIndex].get(field.kind) >> field.sourceShift;
+            word = (word & ~field.mask) | ((value << field.destinationShift) & field.mask);
+            std::memcpy(destination + field.byteOffset, &word, field.width);
+        }
+    }
+
+private:
+    std::vector<NativeHclProgramPage> m_pages;
+    size_t m_alignment = 0;
+    size_t m_stateCount = 0;
+    size_t m_bytes = 0;
+};
+} // namespace hcl
diff --git a/hcl/src/infra/scal/gen2_arch_common/native_hcl_relocation.h b/hcl/src/infra/scal/gen2_arch_common/native_hcl_relocation.h
new file mode 100644
index 0000000..c25e6d7
--- /dev/null
+++ b/hcl/src/infra/scal/gen2_arch_common/native_hcl_relocation.h
@@ -0,0 +1,186 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <algorithm>
+#include <limits>
+#include <vector>
+
+namespace hcl
+{
+enum class NativeHclRelocationKind : uint8_t
+{
+    DEPENDENCY_TARGET,
+    DEPENDENCY_LONG_SO_INDEX,
+    EXTERNAL_COMPLETION_TARGET,
+    INTERNAL_COMPLETION_TARGET,
+    EXTERNAL_COMPLETION_ADDRESS,
+    INTERNAL_COMPLETION_ADDRESS,
+    GPSO_0_ADDRESS,
+    GPSO_1_ADDRESS,
+    RECEIVE_STATE,
+    QUEUE_COUNTER,
+    WQE_COUNTER,
+    WQE_NOTIFY,
+    WQE_WAIT,
+    COUNT
+};
+
+struct NativeHclRelocation
+{
+    uint32_t                commandIndex    = 0;
+    uint32_t                byteOffset      = 0;
+    uint8_t                 width           = 0;
+    uint64_t                mask            = 0;
+    uint8_t                 destinationShift = 0;
+    uint8_t                 sourceShift      = 0;
+    NativeHclRelocationKind kind             = NativeHclRelocationKind::DEPENDENCY_TARGET;
+};
+
+struct NativeHclCommand
+{
+    std::vector<uint8_t> bytes;
+    bool                 submitAfter = false;
+};
+
+struct NativeHclStreamTemplate
+{
+    std::vector<NativeHclCommand>    commands;
+    std::vector<NativeHclRelocation> relocations;
+    uint64_t                         captureTargetValue = 0;
+
+    bool empty() const { return commands.empty(); }
+};
+
+struct NativeHclReplayState
+{
+    uint64_t values[static_cast<size_t>(NativeHclRelocationKind::COUNT)] {};
+
+    uint64_t get(NativeHclRelocationKind kind) const
+    {
+        return values[static_cast<size_t>(kind)];
+    }
+};
+
+inline bool isNativeHclRelocationWellFormed(const NativeHclRelocation& relocation)
+{
+    if (relocation.width != 1 && relocation.width != 2 && relocation.width != 4 && relocation.width != 8)
+    {
+        return false;
+    }
+    if (relocation.destinationShift >= relocation.width * 8 || relocation.sourceShift >= 64 ||
+        relocation.kind >= NativeHclRelocationKind::COUNT)
+    {
+        return false;
+    }
+    const uint64_t widthMask = relocation.width == 8
+                                   ? std::numeric_limits<uint64_t>::max()
+                                   : ((uint64_t {1} << (relocation.width * 8)) - 1);
+    if (relocation.mask == 0 || (relocation.mask & ~widthMask) != 0)
+    {
+        return false;
+    }
+    const uint64_t bitsBelowDestination = relocation.destinationShift == 0
+                                              ? 0
+                                              : ((uint64_t {1} << relocation.destinationShift) - 1);
+    return (relocation.mask & bitsBelowDestination) == 0;
+}
+
+inline bool nativeHclRelocationLess(const NativeHclRelocation& left, const NativeHclRelocation& right)
+{
+    if (left.commandIndex != right.commandIndex)
+    {
+        return left.commandIndex < right.commandIndex;
+    }
+    if (left.byteOffset != right.byteOffset)
+    {
+        return left.byteOffset < right.byteOffset;
+    }
+    return left.mask < right.mask;
+}
+
+inline bool validateNativeHclStreamTemplate(const NativeHclStreamTemplate& commandTemplate)
+{
+    if (commandTemplate.empty())
+    {
+        return false;
+    }
+    for (size_t index = 0; index < commandTemplate.relocations.size(); ++index)
+    {
+        const NativeHclRelocation& relocation = commandTemplate.relocations[index];
+        if (!isNativeHclRelocationWellFormed(relocation) ||
+            relocation.commandIndex >= commandTemplate.commands.size())
+        {
+            return false;
+        }
+        const NativeHclCommand& command = commandTemplate.commands[relocation.commandIndex];
+        if (relocation.byteOffset > command.bytes.size() ||
+            relocation.width > command.bytes.size() - relocation.byteOffset)
+        {
+            return false;
+        }
+        if (index != 0 && nativeHclRelocationLess(relocation, commandTemplate.relocations[index - 1]))
+        {
+            return false;
+        }
+    }
+    return true;
+}
+
+// Completion SOB addresses advance with the HCL completion epoch. The graph
+// generators identify the semantic address at capture time, while scheduler
+// packet writers flatten it into one or more 32-bit LBW fields. Add the
+// corresponding fixed-address relocations once during instantiation.
+inline size_t addNativeHclCapturedWordRelocations(NativeHclStreamTemplate& commandTemplate,
+                                                  uint32_t                 capturedWord,
+                                                  NativeHclRelocationKind  kind)
+{
+    size_t added = 0;
+    for (size_t commandIndex = 0; commandIndex < commandTemplate.commands.size(); ++commandIndex)
+    {
+        const NativeHclCommand& command = commandTemplate.commands[commandIndex];
+        for (size_t byteOffset = 0; byteOffset + sizeof(uint32_t) <= command.bytes.size();
+             byteOffset += sizeof(uint32_t))
+        {
+            uint32_t word = 0;
+            std::memcpy(&word, command.bytes.data() + byteOffset, sizeof(word));
+            if (word != capturedWord)
+            {
+                continue;
+            }
+            commandTemplate.relocations.push_back({.commandIndex = static_cast<uint32_t>(commandIndex),
+                                                    .byteOffset = static_cast<uint32_t>(byteOffset),
+                                                    .width = sizeof(uint32_t),
+                                                    .mask = 0xffffffffu,
+                                                    .destinationShift = 0,
+                                                    .sourceShift = 0,
+                                                    .kind = kind});
+            ++added;
+        }
+    }
+    std::sort(commandTemplate.relocations.begin(),
+              commandTemplate.relocations.end(),
+              nativeHclRelocationLess);
+    return added;
+}
+
+inline bool patchNativeHclRelocation(uint8_t*                    commandBytes,
+                                     size_t                      commandSize,
+                                     const NativeHclRelocation&  relocation,
+                                     const NativeHclReplayState& replayState)
+{
+    if (commandBytes == nullptr || !isNativeHclRelocationWellFormed(relocation) ||
+        relocation.byteOffset > commandSize || relocation.width > commandSize - relocation.byteOffset)
+    {
+        return false;
+    }
+
+    uint64_t word = 0;
+    std::memcpy(&word, commandBytes + relocation.byteOffset, relocation.width);
+    const uint64_t value = replayState.get(relocation.kind) >> relocation.sourceShift;
+    word = (word & ~relocation.mask) | ((value << relocation.destinationShift) & relocation.mask);
+    std::memcpy(commandBytes + relocation.byteOffset, &word, relocation.width);
+    return true;
+}
