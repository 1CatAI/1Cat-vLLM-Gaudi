+        (mode != hcclTp2NativeReduction && mode != hcclTp2NativeExchange) || streamHandle == nullptr ||
+        !GCFG_HCL_TP2_DEDICATED_DIRECT_API.value())
+    {
+        return hcclInvalidArgument;
+    }
+    *graphHandle = nullptr;
