+{
+    hcclTp2NativeGraphCreated = 0,
+    hcclTp2NativeGraphCapturing,
+    hcclTp2NativeGraphInstantiated,
+    hcclTp2NativeGraphInvalid,
+    hcclTp2NativeGraphClosed
