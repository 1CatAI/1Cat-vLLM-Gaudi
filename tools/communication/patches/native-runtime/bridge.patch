diff --git a/habana_eager/graph_execs_group.h b/habana_eager/graph_execs_group.h
index 2b8501f2d..10be40fa7 100644
--- a/habana_eager/graph_execs_group.h
+++ b/habana_eager/graph_execs_group.h
@@ -53,6 +53,19 @@ struct GraphExecsGroup {
 
   void ResetSeed();
 
+  // Internal ABI for prepared inference plans. No object layout changes.
+  // Call after warm execution and after joining the lowering queue. A plan
+  // validates every input's shape, stride and offset before each replay.
+  GraphExec* prepared_static_exec(torch::jit::Stack& inputs) {
+    HABANA_ASSERT(!m_dynamic && m_inference && !m_has_randoms,
+                  "Prepared execution requires static deterministic inference");
+    const auto key = generate_key(inputs);
+    const auto found = m_graph_exec_storage.find(key);
+    HABANA_ASSERT(found != m_graph_exec_storage.end(), "Prepared graph offset variant was not warmed");
+    HABANA_ASSERT(found->second.HasOptimizedGraph(), "Prepared graph was not lowered");
+    return &found->second;
+  }
+
   GraphExecsGroup() = delete;
   GraphExecsGroup(const GraphExecsGroup&) = delete;
   GraphExecsGroup(GraphExecsGroup&&) = default;
diff --git a/habana_eager/graph_storage.h b/habana_eager/graph_storage.h
