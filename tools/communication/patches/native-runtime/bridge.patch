+++ b/habana_eager/graph_storage.h
@@ -44,6 +44,13 @@ class GraphStorage {
       std::string& parent_graph_name);
   void reset_seeds();
 
+  // The unordered-map element retained by this pointer remains stable when
+  // the recipe catalog grows. GraphStorage retains recipes for process life.
+  GraphExec* prepared_static_exec(size_t recipe_id, torch::jit::Stack& inputs) {
+    HABANA_ASSERT(recipe_id < m_storage_vec.size(), "Unknown prepared recipe");
+    return m_storage_vec.at(recipe_id).prepared_static_exec(inputs);
+  }
+
  private:
   GraphStorage() {};
   GraphStorage(const GraphStorage&) = delete;
